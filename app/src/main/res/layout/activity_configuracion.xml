<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F4F8FC"
            android:padding="16dp">

    <LinearLayout
            android:id="@+id/layoutMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
                android:id="@+id/tvTituloConfiguracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuración de Perfil"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/azul_menu"
                android:layout_marginBottom="16dp" />

        <!-- Contenedor principal -->
        <LinearLayout
                android:id="@+id/layoutContenedor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

            <!-- Subtítulo Perfil -->
            <TextView
                    android:id="@+id/tvPerfilSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perfil"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/azul_principal"
                    android:layout_marginBottom="12dp" />

            <!-- Nombre -->
            <TextView
                    android:id="@+id/tvNombreCompletoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre completo"
                    android:textStyle="bold"
                    android:textColor="@color/azul_secundario"
                    android:layout_marginBottom="4dp" />

            <EditText
                    android:id="@+id/etNombreCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="(Nombre)"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />

            <!-- Especialidad -->
            <TextView
                    android:id="@+id/tvEspecialidadLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Especialidad"
                    android:textStyle="bold"
                    android:textColor="@color/azul_secundario"
                    android:layout_marginBottom="4dp" />

            <EditText
                    android:id="@+id/etEspecialidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Sin especialidad"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />

            <!-- Teléfono -->
            <TextView
                    android:id="@+id/tvTelefonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono"
                    android:textStyle="bold"
                    android:textColor="@color/azul_secundario"
                    android:layout_marginBottom="4dp" />

            <EditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="+57 34567890"
                    android:inputType="phone"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp" />

            <!-- Correo electrónico -->
            <TextView
                    android:id="@+id/tvCorreoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico"
                    android:textStyle="bold"
                    android:textColor="@color/azul_secundario"
                    android:layout_marginBottom="4dp" />

            <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="odontologo@dentalflow.com"
                    android:inputType="textEmailAddress"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginBottom="20dp" />

            <!-- Botón Guardar -->
            <Button
                    android:id="@+id/btnGuardarConfiguracion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guardar configuración"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/azul_menu"
                    android:padding="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
