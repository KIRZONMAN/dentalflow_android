<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="@color/white">

    <!-- Encabezado -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/azul_menu"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <ImageView
                android:id="@+id/logoApp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/logo1"
                android:contentDescription="Logo" />

        <TextView
                android:id="@+id/tvTituloPanel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Panel del administrador"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

        <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cerrar Sesión"
                android:backgroundTint="@color/azul_principal"
                android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Bienvenida -->
    <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hola Administrador X 👋"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:padding="8dp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Bienvenido al panel de control de DentalFlow!"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

    <!-- Grid con botones -->
    <GridLayout
            android:id="@+id/gridOpciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:rowCount="3"
            android:useDefaultMargins="true">

        <!-- Botón Gestión de Usuarios -->
        <Button
                android:id="@+id/btnUsuarios"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:text="Gestión de Usuarios"
                android:drawableTop="@drawable/gestion_usuarios"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_margin="12dp"/>

        <!-- Botón Asistente -->
        <Button
                android:id="@+id/btnAsistente"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:text="Asistente"
                android:drawableTop="@drawable/asistente"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_margin="12dp"/>

        <!-- Botón Odontólogo -->
        <Button
                android:id="@+id/btnOdontologo"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:text="Odontólogo"
                android:drawableTop="@drawable/odontologo"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_margin="12dp"/>

        <!-- Botón Laboratorista -->
        <Button
                android:id="@+id/btnLaboratorista"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:text="Laboratorista"
                android:drawableTop="@drawable/laboratorista"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_margin="12dp"/>

        <!-- Botón Proveedores -->
        <Button
                android:id="@+id/btnProveedores"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:text="Gestión de Proveedores"
                android:drawableTop="@drawable/gestion_proveedores"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_margin="12dp"/>

        <!-- Botón Procedimientos -->
        <Button
                android:id="@+id/btnProcedimientos"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:text="Procedimientos"
                android:drawableTop="@drawable/procedimientos"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_margin="12dp"/>
    </GridLayout>

</LinearLayout>
