<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/blanco"
            android:padding="12dp">

    <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <!-- Encabezado -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/azul_menu"
                android:orientation="horizontal"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:gravity="center_vertical">

            <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/logo1"
                    android:contentDescription="Logo" />

            <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Solicitud de Prótesis"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="22sp" />
        </LinearLayout>

        <!-- Contenido -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@android:color/transparent">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cita:"
                    android:layout_marginTop="8dp"
                    android:textColor="#000000"
                    android:textStyle="bold"/>

            <Spinner
                    android:id="@+id/spCita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="10dp"
                    android:background="@android:drawable/edit_text" />

            <!-- Tipo de Pedido / Material -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo de Pedido / Material"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp"
                    android:textColor="#000000" />

            <EditText
                    android:id="@+id/etTipoPedido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Superior / Inferior / Otro"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginTop="6dp" />

            <!-- Checkboxes (dos columnas) -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <CheckBox
                            android:id="@+id/cbMetalPorcelana"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Metal Porcelana" />

                    <CheckBox
                            android:id="@+id/cbZirconio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zirconio" />

                    <CheckBox
                            android:id="@+id/cbProtesisTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prótesis Total" />

                    <CheckBox
                            android:id="@+id/cbProtesisParcial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prótesis Parcial" />

                    <CheckBox
                            android:id="@+id/cbOrtodoncia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ortodoncia" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                    <CheckBox
                            android:id="@+id/cbSuperior"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Superior" />

                    <CheckBox
                            android:id="@+id/cbInferior"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inferior" />

                    <CheckBox
                            android:id="@+id/cbAcrilico"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Acrílico" />

                    <CheckBox
                            android:id="@+id/cbFlexible"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Flexible" />
                </LinearLayout>
            </LinearLayout>

            <!-- Otros detalles -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Otros Detalles"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp"
                    android:textColor="#000000" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color:"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold"
                    android:textColor="#000000" />
            <EditText
                android:id="@+id/etColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="A2"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"
                android:layout_marginTop="6dp" />
            <!-- Botón subir imagen desde el dispositivo -->
            <Button
                    android:id="@+id/btnSubirFirma"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawableLeft="@android:drawable/ic_menu_upload"
                    android:padding="10dp"
                    android:text="  Subir imagen de firma"
                    android:background="@android:drawable/edit_text" />

            <!-- Botón enviar -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnviar"
                    android:layout_width="220dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:layout_gravity="center_horizontal"
                    android:text="Enviar Solicitud"
                    android:textColor="@android:color/white"
                    app:cornerRadius="28dp"
                    app:backgroundTint="@color/azul_principal"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
