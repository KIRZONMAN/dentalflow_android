<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@color/white"
              android:orientation="vertical"
              android:padding="16dp">

    <!-- Encabezado -->
    <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/azul_menu"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <ImageView
                android:id="@+id/ivIconHistoria"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Historia clínica" />

        <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historia Clínica de"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginStart="12dp" />

        <TextView
                android:id="@+id/tvNombreUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TESTER2"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Encabezado de tabla -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/azul_principal"
            android:padding="12dp">

        <TextView
                android:id="@+id/tvAntecedentesTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Antecedentes"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center" />

        <TextView
                android:id="@+id/tvTratamientosTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tratamientos realizados"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center" />

        <TextView
                android:id="@+id/tvAccionesTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acciones"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:gravity="center" />
    </LinearLayout>

    <!-- RecyclerView para filas -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistoria"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:clipToPadding="false"/>

    <!-- Botón volver -->
    <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver a Agenda"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/azul_secundario"
            android:padding="10dp"
            android:layout_marginTop="12dp"
            android:layout_gravity="start"/>
</LinearLayout>
